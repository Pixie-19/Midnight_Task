# ── Midnight Level 2 — Environment Variables ─────────────────────────────────
#
# Copy this file to .env and fill in the values.
# All VITE_ prefixed variables are inlined into the browser bundle at build time.
# Do NOT put secrets (seed phrases, private keys) in .env — use the Lace
# wallet extension to sign transactions instead.

# ── Network ───────────────────────────────────────────────────────────────────

# The Midnight network to target. Must match what the Lace wallet is configured for.
# Supported: preprod | preview
VITE_NETWORK_ID=preprod

# ── Contract ──────────────────────────────────────────────────────────────────

# The on-chain address of the deployed eligibility contract on Preprod.
# Obtain this by running: npm run deploy --network preprod  in midnight-level1/
# Example: VITE_CONTRACT_ADDRESS=<hex address from .midnight-state.json>
VITE_CONTRACT_ADDRESS=

# ── Indexer ───────────────────────────────────────────────────────────────────

# Preprod indexer endpoint (override if using Blockfrost or a custom indexer).
VITE_INDEXER_HTTP=https://indexer.preprod.midnight.network/api/v4/graphql
VITE_INDEXER_WS=wss://indexer.preprod.midnight.network/api/v4/graphql/ws

# ── Proof Server ──────────────────────────────────────────────────────────────

# The proof server generates ZK proofs locally. Run it with:
#   docker compose up -d  (inside midnight-level1/)
# The proof-server image is: midnightntwrk/proof-server:8.1.0
VITE_PROOF_SERVER_URL=http://localhost:6300

# ── ZK Config ─────────────────────────────────────────────────────────────────

# Base URL where the compiled ZK key files are served.
# In development, Vite serves /public at /  →  use /eligibility
# In production (Vercel), these are served as static assets.
VITE_ZK_CONFIG_BASE_URL=/eligibility
